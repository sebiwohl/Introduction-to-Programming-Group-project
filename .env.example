# Copy the names you need into .streamlit/secrets.toml (git-ignored) or set them
# as environment variables. Never commit real values.

# Real data (Supabase > Connect > Session pooler). Leave unset to use data/data.json.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Empty test database for tests/test_storage_db.py. Never the real database.
TEST_DATABASE_URL="postgresql://postgres.TEST_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Password for the demo accounts made by scripts/seed.py. Placeholder only.
SEED_PASSWORD="CHOOSE_A_DEMO_PASSWORD"
